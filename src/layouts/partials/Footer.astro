---
import ContractAddress from "@/components/ContractAddress.astro";
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";

const copyright = config.params.copyright.replace("{year}", new Date().getFullYear().toString());
const { token, contact } = config;

const tokenLinks = [
  { name: "Buy $MAGYK", url: token.sale_url },
  { name: "Chart on DEXTools", url: token.dextools_url },
  { name: "Block explorer", url: token.explorer_url },
];
---

<footer class="relative mt-10 border-t border-border">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/60 to-transparent"
  >
  </div>
  <div class="container grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="space-y-6 lg:col-span-5">
      <Logo />
      <p class="max-w-sm text-light">
        A community-forged token and NFT realm on {token.chain}. Where limits and chains fade into mist.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        {
          social.main.map((s) => (
            <a
              href={s.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`MAGYK on ${s.name}`}
              class="grid h-10 w-10 place-items-center rounded-full border border-border text-text transition-colors hover:border-primary/50 hover:text-primary"
            >
              <Icon name="x" size={18} />
            </a>
          ))
        }
        <a
          href={`mailto:${contact.email}`}
          aria-label={`Email ${contact.email}`}
          class="grid h-10 w-10 place-items-center rounded-full border border-border text-text transition-colors hover:border-primary/50 hover:text-primary"
        >
          <Icon name="mail" size={18} />
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-7">
      <div>
        <h2 class="mb-5 font-primary text-xs font-semibold uppercase tracking-[0.18em] text-light">Explore</h2>
        <ul class="space-y-3">
          {
            menu.footer.explore.map((item) => (
              <li>
                <a href={item.url} class="text-text/85 transition-colors hover:text-primary">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="mb-5 font-primary text-xs font-semibold uppercase tracking-[0.18em] text-light">Token</h2>
        <ul class="space-y-3">
          {
            tokenLinks.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-text/85 transition-colors hover:text-primary"
                >
                  {item.name}
                  <Icon name="external" size={13} class="opacity-60" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="mb-5 font-primary text-xs font-semibold uppercase tracking-[0.18em] text-light">Legal</h2>
        <ul class="space-y-3">
          {
            menu.footer.legal.map((item) => (
              <li>
                <a href={item.url} class="text-text/85 transition-colors hover:text-primary">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container flex flex-col gap-6 py-8 lg:flex-row lg:items-center lg:justify-between">
      <ContractAddress />
      <p class="text-sm text-light">{copyright}</p>
    </div>
    <p class="container pb-10 text-xs leading-relaxed text-light/70">
      Nothing on this website is financial advice. Crypto assets are highly volatile and you can lose the full amount
      you put in. Always verify the contract address and do your own research before interacting with any token.
    </p>
  </div>
</footer>
