---
import Icon from "@/components/Icon.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { getEntry } from "astro:content";

const { eyebrow, title, description, list, pfife } = (await getEntry("features", "features"))!.data;
---

<section class="section relative">
  <div class="container">
    <SectionTitle eyebrow={eyebrow} title={title} description={description} />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        list.map((item, i) => (
          <article class="card card-hover p-7" data-reveal data-reveal-delay={String(i * 80)}>
            <div class="icon-badge">
              <Icon name={item.icon} size={22} />
            </div>
            <h3 class="mt-6 font-primary text-xl font-semibold tracking-normal">{item.title}</h3>
            <p class="mt-3 text-light">{item.description}</p>
          </article>
        ))
      }
    </div>

    <div class="card border-gradient relative mt-8 overflow-hidden p-8 md:p-12 lg:p-16" data-reveal>
      <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-secondary/25 blur-3xl"></div>
      <div class="absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-2">
        <div class="space-y-5">
          <span class="eyebrow"><Icon name="sparkles" size={14} /> {pfife.eyebrow}</span>
          <h3 class="text-h3-sm md:text-h2-sm">{pfife.title}</h3>
          <p class="text-lg text-light">{pfife.description}</p>
        </div>
        <ul class="space-y-4">
          {
            pfife.points.map((point) => (
              <li class="flex items-center gap-4 rounded-xl border border-border bg-body/40 px-5 py-4">
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary/15 text-primary">
                  <Icon name="check" size={16} />
                </span>
                <span class="text-lg">{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
