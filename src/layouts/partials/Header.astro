---
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (url: string) => path === url || path.startsWith(`${url}/`);
const cta = config.navigation_button;
---

<header class="site-header" data-scrolled="false">
  <nav class="container flex h-20 items-center justify-between gap-6" aria-label="Main">
    <Logo />

    <ul class="hidden items-center gap-1 lg:flex">
      {
        menu.main.map((item) => (
          <li>
            <a href={item.url} class="nav-link" aria-current={isActive(item.url) ? "page" : undefined}>
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      {
        cta.enable && (
          <a href={cta.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm hidden sm:inline-flex">
            {cta.label}
            <Icon name="arrow" size={16} />
          </a>
        )
      }
      <button
        type="button"
        class="menu-toggle grid h-11 w-11 place-items-center rounded-full border border-border text-text lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="menu-open"><Icon name="menu" size={20} /></span>
        <span class="menu-close hidden"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/5 bg-body/95 backdrop-blur-xl lg:hidden">
    <ul class="container flex flex-col gap-1 py-6">
      {
        menu.main.map((item) => (
          <li>
            <a
              href={item.url}
              class="block rounded-xl px-4 py-3 font-secondary text-xl text-text hover:bg-white/5 aria-[current=page]:text-primary"
              aria-current={isActive(item.url) ? "page" : undefined}
            >
              {item.name}
            </a>
          </li>
        ))
      }
      {
        cta.enable && (
          <li class="mt-4">
            <a href={cta.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full">
              {cta.label}
              <Icon name="arrow" size={16} />
            </a>
          </li>
        )
      }
    </ul>
  </div>
</header>

<script>
  let controller: AbortController | undefined;

  function initHeader() {
    const header = document.querySelector<HTMLElement>(".site-header");
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const panel = document.getElementById("mobile-menu");
    if (!header || !toggle || !panel) return;

    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const setScrolled = () => {
      header.dataset.scrolled = String(window.scrollY > 12 || toggle.getAttribute("aria-expanded") === "true");
    };
    setScrolled();
    window.addEventListener("scroll", setScrolled, { passive: true, signal });

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.classList.toggle("hidden", !open);
      toggle.querySelector(".menu-open")?.classList.toggle("hidden", open);
      toggle.querySelector(".menu-close")?.classList.toggle("hidden", !open);
      setScrolled();
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false), { signal });
  }
  document.addEventListener("astro:page-load", initHeader);
</script>
