---
import Icon from "@/components/Icon.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { getEntry } from "astro:content";

const { list } = (await getEntry("faq", "faq"))!.data;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: list.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<section class="section">
  <div class="container grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-32">
        <SectionTitle
          align="left"
          eyebrow="Got mystical queries?"
          title="Frequently asked questions"
          description="Still curious? Reach the team on X or by email and we'll answer."
        />
        <a href="/contact" class="btn btn-outline" data-reveal>Contact the team</a>
      </div>
    </div>
    <div class="lg:col-span-8" data-reveal>
      {
        list.map((faq, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              {faq.question}
              <span class="faq-icon">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
