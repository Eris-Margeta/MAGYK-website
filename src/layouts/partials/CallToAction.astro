---
import Icon from "@/components/Icon.astro";
import Img from "@/components/Img.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";

const x = social.main[0];
---

<section class="section">
  <div class="container">
    <div class="border-gradient relative isolate overflow-hidden rounded-[2rem] px-6 py-20 text-center md:px-16 md:py-28" data-reveal>
      <Img
        src="/images/magyk/realm.jpg"
        alt=""
        width={1400}
        height={1400}
        sizes="100vw"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_35%] opacity-60"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-body via-body/70 to-body/40"></div>
      <span class="eyebrow">The spells have been cast</span>
      <h2 class="mx-auto mt-6 max-w-3xl text-h2-sm md:text-h1">
        Step into the <span class="text-gold">realm of MAGYK</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg text-text/80">
        Grab {config.token.symbol} on {config.token.chain} and follow along as the next stages of the roadmap unfold.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={config.token.sale_url} target="_blank" rel="noopener noreferrer" class="btn btn-primary px-8 py-4 text-base">
          Buy {config.token.symbol}
          <Icon name="arrow" size={18} />
        </a>
        <a href={x.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline px-8 py-4 text-base">
          <Icon name="x" size={16} />
          Follow @MAGYKcrypto
        </a>
      </div>
    </div>
  </div>
</section>
