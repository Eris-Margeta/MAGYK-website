---
import Icon from "@/components/Icon.astro";
import { getEntry } from "astro:content";

interface Props {
  variant?: "compact" | "full";
}

const { variant = "full" } = Astro.props;
const { stages } = (await getEntry("roadmap", "roadmap"))!.data;

const statusLabel = { current: "In progress", upcoming: "Upcoming", sealed: "Sealed" } as const;
---

{
  variant === "compact" ? (
    <ol class="relative grid gap-4 before:absolute before:left-0 before:right-0 before:top-[1.4rem] before:hidden before:h-px before:bg-gradient-to-r before:from-primary before:via-secondary/50 before:to-transparent md:grid-cols-5 md:before:block">
      {stages.map((s, i) => (
        <li class="relative" data-reveal data-reveal-delay={String(i * 90)}>
          <div
            class={`relative z-10 grid h-11 w-11 place-items-center rounded-full border font-secondary font-bold ${
              s.status === "current"
                ? "border-primary bg-primary text-dark shadow-[0_0_30px_rgba(233,196,106,0.6)]"
                : "border-border bg-body text-primary"
            }`}
          >
            {s.status === "sealed" ? <Icon name="lock" size={16} /> : s.stage}
          </div>
          <div class="card card-hover mt-5 h-[calc(100%-4rem)] p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Stage {s.stage}</p>
            <h3 class="mt-2 text-xl">{s.name}</h3>
            <p class="mt-1 text-sm font-medium text-text/80">{s.title}</p>
            <p class="mt-3 text-sm text-light">{s.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="relative mx-auto max-w-4xl before:absolute before:bottom-0 before:left-[1.35rem] before:top-0 before:w-px before:bg-gradient-to-b before:from-primary before:via-secondary/40 before:to-transparent md:before:left-1/2">
      {stages.map((s, i) => (
        <li class="relative mb-12 grid gap-6 pl-16 md:grid-cols-2 md:gap-16 md:pl-0">
          <div
            class={`absolute left-0 top-2 z-10 grid h-11 w-11 place-items-center rounded-full border font-secondary font-bold md:left-1/2 md:-translate-x-1/2 ${
              s.status === "current"
                ? "border-primary bg-primary text-dark shadow-[0_0_30px_rgba(233,196,106,0.6)]"
                : "border-border bg-body text-primary"
            }`}
          >
            {s.status === "sealed" ? <Icon name="lock" size={16} /> : s.stage}
          </div>
          <div
            class={`card border-gradient p-7 md:p-8 ${i % 2 ? "md:text-right" : "md:col-start-2"}`}
            data-reveal
          >
            <div class={`flex flex-wrap items-center gap-3 ${i % 2 ? "md:justify-end" : ""}`}>
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Stage {s.stage}</span>
              <span
                class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                  s.status === "current" ? "bg-emerald-400/15 text-emerald-300" : "bg-white/5 text-light"
                }`}
              >
                {statusLabel[s.status]}
              </span>
            </div>
            <h2 class="mt-3 text-h4 md:text-h3-sm">{s.name}</h2>
            <p class="mt-1 font-medium text-text/80">{s.title}</p>
            <p class="mt-4 text-light">{s.summary}</p>
            <ul class={`mt-5 space-y-2.5 ${i % 2 ? "md:ml-auto" : ""}`}>
              {s.items.map((item) => (
                <li class={`flex gap-3 text-left text-text/90 ${i % 2 ? "md:flex-row-reverse md:text-right" : ""}`}>
                  <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rotate-45 bg-primary" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  )
}
