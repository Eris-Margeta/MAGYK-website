---
import config from "@/config/config.json";

const { class: className = "" } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${className}`} aria-label={`${config.site.title} home`}>
  <img
    src="/images/magyk/sigil.svg"
    alt=""
    width="36"
    height="36"
    class="h-9 w-9 transition-transform duration-700 group-hover:rotate-[360deg]"
  />
  <span class="font-secondary text-2xl font-bold tracking-[0.12em] text-gold">{config.site.logo_text}</span>
</a>
