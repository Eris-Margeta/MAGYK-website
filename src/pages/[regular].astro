---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PageHero from "@/partials/PageHero.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getSinglePage("pages");
  return pages.map((page) => ({
    params: { regular: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { title, meta_title, description, image } = page.data;
const { Content } = await render(page);
const heading = title.replace(/^Magyk\s*-\s*/i, "");
---

<Base title={heading} meta_title={meta_title} description={description} image={image}>
  <PageHero eyebrow="Legal" title={heading} />
  <section class="section pt-0">
    <div class="container max-w-3xl">
      <div class="content">
        <Content />
      </div>
    </div>
  </section>
</Base>
