---
import Icon from "@/components/Icon.astro";
import Base from "@/layouts/Base.astro";
import PageHero from "@/partials/PageHero.astro";
---

<Base title="Page not found" description="This page has vanished into the mist." noindex>
  <PageHero
    eyebrow="404"
    title="This page vanished into the mist"
    description="The spell you cast led nowhere. Let’s get you back to the realm."
    image="/images/magyk/forest.jpg"
  >
    <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal data-reveal-delay="240">
      <a href="/" class="btn btn-primary">
        Back to home
        <Icon name="arrow" size={16} />
      </a>
      <a href="/whitepaper" class="btn btn-outline">Read the whitepaper</a>
    </div>
  </PageHero>
</Base>
